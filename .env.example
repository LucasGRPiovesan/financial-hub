# Copy to .env (git-ignored). No real secrets belong in this file.

# --- application ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- database (compose service `db`) ---
POSTGRES_USER=financial_hub
POSTGRES_PASSWORD=financial_hub
POSTGRES_DB=financial_hub
DATABASE_URL=postgresql+psycopg://financial_hub:financial_hub@db:5432/financial_hub

# --- host port mappings ---
DB_PORT=5432
API_PORT=8000
WEB_PORT=5173
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
