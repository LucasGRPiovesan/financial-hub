# Copy to .env (git-ignored). No real secrets belong in this file.
# Application settings use the FH_ prefix (backend/src/financial_hub/platform/settings.py).

# --- application ---
FH_APP_ENV=dev
FH_LOG_LEVEL=INFO

# --- database (compose service `db`) ---
POSTGRES_USER=financial_hub
POSTGRES_PASSWORD=financial_hub
POSTGRES_DB=financial_hub
# POSTGRES_* is the owner/migration login: only the `migrate` and `test` services receive it.
# `api`/`worker` connect as the restricted role fh_app (created by migration 0001) with this
# password. Dev default only; URL-safe characters (it is embedded in a connection URL).
FH_APP_DB_PASSWORD=fh_app_dev_only

# --- observability: the `lgtm` service is opt-in (empty endpoint disables export) ---
# COMPOSE_PROFILES=observability
# FH_OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318

# --- operator sessions and login throttling (defaults shown; docs/SECURITY.md) ---
# Settings read by the app. deploy/compose.yaml does not forward them yet, so uncommenting has
# effect only where the process sees the environment directly (e.g. a `-e` on `compose run`).
# FH_SESSION_IDLE_TIMEOUT_MINUTES=30
# FH_SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# FH_SESSION_TOUCH_INTERVAL_SECONDS=60
# FH_LOGIN_MAX_FAILURES=5
# FH_LOGIN_FAILURE_WINDOW_MINUTES=15
# FH_LOGIN_LOCKOUT_MINUTES=15
# FH_LOGIN_IP_MAX_ATTEMPTS=30
# FH_LOGIN_IP_WINDOW_MINUTES=15
# Bootstrap operator password for `python -m financial_hub.cli create-operator`
# (docs/DEVELOPMENT.md). Pass it per command, never store a real one here; it is never argv.
# FH_BOOTSTRAP_PASSWORD=

# --- secrets at rest: versioned AES-256 data keys, JSON {"<version>": "<base64 of 32 bytes>"} ---
# Generate one with: docker compose run --rm --no-deps api python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# FH_ENCRYPTION_KEYS={"1":"<base64 key>"}
# Provider credentials are sealed with the highest version; to rotate, add a new version (keep the
# old ones so existing rows still decrypt). Required outside dev/test.

# --- API keys: HMAC pepper for the stored digest of key secrets (keep it out of the database) ---
# At least 32 random characters, required (and not this placeholder) outside dev/test. Rotating it
# invalidates every issued key. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
# FH_API_KEY_PEPPER=<random secret, 32+ characters>
# An API key's last_used_at is written at most once per interval.
# FH_API_KEY_TOUCH_INTERVAL_SECONDS=60

# --- host port mappings ---
DB_PORT=5432
API_PORT=8000
WEB_PORT=5173
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
