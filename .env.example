# Copy to .env (git-ignored). No real secrets belong in this file.
# Application settings use the FH_ prefix (backend/src/financial_hub/platform/settings.py).

# --- application ---
FH_APP_ENV=dev
FH_LOG_LEVEL=INFO

# --- database (compose service `db`) ---
POSTGRES_USER=financial_hub
POSTGRES_PASSWORD=financial_hub
POSTGRES_DB=financial_hub
# POSTGRES_* is the owner/migration login: only the `migrate` and `test` services receive it.
# `api`/`worker` connect as the restricted role fh_app (created by migration 0001) with this
# password. Dev default only; URL-safe characters (it is embedded in a connection URL).
FH_APP_DB_PASSWORD=fh_app_dev_only

# --- observability (compose service `lgtm`; OTLP/HTTP base URL, empty disables export) ---
FH_OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318

# --- secrets at rest: versioned AES-256 data keys, JSON {"<version>": "<base64 of 32 bytes>"} ---
# Generate one with: docker compose run --rm --no-deps api python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# FH_ENCRYPTION_KEYS={"1":"<base64 key>"}

# --- host port mappings ---
DB_PORT=5432
API_PORT=8000
WEB_PORT=5173
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
